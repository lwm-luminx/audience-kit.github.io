---
import Layout from '../../layouts/Default.astro';
import LiveStats from '../../components/LiveStats.astro';
import site from '../../data/config.json';
import apps from '../../data/staff_apps.json';
const velvet = apps.find((app) => app.slug === 'velvet');
const icon = {
  page: '<path d="m2 7 4.4-4.4A2 2 0 0 1 7.8 2h8.4a2 2 0 0 1 1.4.6L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M2 7h20v3a2 2 0 0 1-2 2 2.7 2.7 0 0 1-2-1 2.7 2.7 0 0 1-2 1 2.7 2.7 0 0 1-2-1 2.7 2.7 0 0 1-2 1 2.7 2.7 0 0 1-2-1 2.7 2.7 0 0 1-2 1 2 2 0 0 1-2-2Z"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/>',
  qr: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3"/>',
  scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  chart: '<path d="M3 3v18h18"/><path d="M8 17V9M13 17V5M18 17v-3"/>',
  id: '<rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="12" r="2"/><path d="M14 10h4M14 14h4"/>',
  list: '<path d="M10 6h11M10 12h11M10 18h11M4 6h1v4M4 10h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/>',
  tv: '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="m17 2-5 5-5-5"/>',
  chat: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>',
  key: '<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"/>',
  check: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/>',
  bot: '<rect x="3" y="11" width="18" height="10" rx="2"/><path d="M12 7v4M8 16h.01M16 16h.01"/><circle cx="12" cy="5" r="2"/>',
  ban: '<circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>',
};
const found = [
  ['page', 'A venue page that stays current', 'Photos, hours, tonight’s events and who is performing, edited from Velvet.'],
  ['calendar', 'Events that surface on the night', 'One-offs and weekly series show up in the city’s Tonight and Everywhere views.'],
  ['mic', 'Performers bring their fans', 'Every act links to its own page, so a drag star’s followers find your stage.'],
  ['qr', 'A room that talks back', 'Guests who are there join your venue chat from a QR at the door or on the TV.'],
];
const door = [
  ['scan', 'Scan passes in a second', 'Guests pay cover in Hot Mess and show a pass that changes every 30 seconds, so a screenshot won’t get a friend in.', ''],
  ['card', 'Cover goes to your account', 'Connect your own Square or Stripe. Cover taken in person at the door carries no app fees at all.', ''],
  ['chart', 'Totals while the night runs', 'See who is in and what the door took tonight, not after you count the cash box.', ''],
  ['id', 'ID checks with a short log', 'Scan an ID for age only, flag “no alcohol sale”, and keep a short log you can show the police.', 'Coming soon'],
];
const night = [
  ['list', 'Lineup and running order', 'Acts, stages and set times, changed live and shown everywhere at once. Karaoke nights run on KaraFun, our karaoke partner.'],
  ['tv', 'The marquee on your TV', 'Tonight’s lineup and live chat on the bar TV, by AirPlay, Chromecast, an Android TV box or a Mac running Velvet.'],
  ['chat', 'Venue chat, moderated', 'Pin tonight’s special, answer guests, remove what doesn’t belong.'],
  ['image', 'Posters for every headliner', 'Story, feed and print sizes made from the act’s approved photo.'],
];
const safety = [
  ['phone', 'A guest asks for help', 'Anyone checked in at your venue can send a quiet alert from Hot Mess.'],
  ['users', 'Staff on shift hear it', 'Velvet puts staff on shift when they arrive at the venue, and off when they leave.'],
  ['check', 'Managers if nobody answers', 'An alert nobody picks up goes to venue managers after two minutes.'],
];
const team = [
  ['key', 'One code sets up the door phone', 'A manager makes a one-time code that works for 15 minutes. Scan it and that phone is connected.'],
  ['check', 'Only what that device needs', 'Door, chat and moderation, events, or full venue admin. Nothing reaches beyond your venue.'],
  ['ban', 'Revoke in one tap', 'Access lasts 90 days. Lose a phone or a staffer and it stops working at once.'],
  ['users', 'Performers run their own pages', 'Acts keep their profile and gigs current in Backstage, so your lineup stays right.'],
];
const svg = (name: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name as keyof typeof icon]}</svg>`;
---
<Layout title="AudienceKit for Venues" description="Get found on Hot Mess, run your door, lineup, screens and chat from Velvet, and keep your guests and your money your own. AudienceKit for bars, clubs and venues.">

<section class="section wrap scene venues-hero" aria-labelledby="venues-title">
  <div>
    <p class="eyebrow">AudienceKit for venues</p>
    <h1 id="venues-title">Fill the room.<br><em>Run the night.</em></h1>
  </div>
  <div class="scene-copy">
    <p class="large-copy">One platform, from the listing to last call.</p>
    <p>Most venues run the night on five tools that don’t talk: posts that land too late, a ticket site that keeps the guest list, a clipboard at the door, a staff group chat, a TV looping an old flyer. None of it shows up when someone is picking where to go tonight.</p>
    <p>AudienceKit gets your venue found on <a href="https://hotmess.social">Hot Mess</a>, runs the door, the lineup, the screens and the chat from <a href={'/apps/velvet/'}>Velvet</a>, and keeps your guests and your money your own.</p>
    <p class="venues-cta"><a class="button primary" href={`mailto:${site.contact_email}?subject=AudienceKit%20for%20my%20venue`}>Bring your venue <span aria-hidden="true">↗</span></a><a class="text-link" href={'/apps/velvet/'}>Get Velvet <span aria-hidden="true">→</span></a><a class="text-link" href={'/pitch/venues/'}>The venue pitch deck <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<section class="section capabilities" id="found" aria-labelledby="found-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Get found · Hot Mess</p>
      <h2 class="capability-title" id="found-title">Be where your crowd decides where to go</h2>
      <p class="capability-intro">Hot Mess is the app for queer nights out, on iPhone, Android and the web. Your venue sits where people look when they’re choosing tonight, with no outside brand ads and no ad tracking around it.</p>
    </div>
    <div class="capability-grid venues-grid-4">
      {found.map(([i, h, p]) => (<article class="capability-card"><div class="feature__icon" set:html={svg(i)} /><h3>{h}</h3><p>{p}</p></article>))}
    </div>
  </div>
</section>

<LiveStats eyebrow="Hot Mess today" intro="Counted from the platform as you read this." />

<section class="section capabilities" id="door" aria-labelledby="door-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Run the door · Velvet</p>
      <h2 class="capability-title" id="door-title">A door that keeps up with the line</h2>
    </div>
    <div class="capability-grid venues-grid-4">
      {door.map(([i, h, p, tag]) => (<article class="capability-card"><div class="feature__icon" set:html={svg(i)} />{tag && <p class="feature-number venues-tag">{tag}</p>}<h3>{h}</h3><p>{p}</p></article>))}
    </div>
  </div>
</section>

<section class="section capabilities" id="night" aria-labelledby="night-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Run the night · Velvet</p>
      <h2 class="capability-title" id="night-title">Tonight, on every screen</h2>
      <p class="capability-intro">Change a set time once and it changes on the venue page, in the chat and on the bar TV.</p>
    </div>
    <div class="capability-grid venues-grid-4">
      {night.map(([i, h, p]) => (<article class="capability-card"><div class="feature__icon" set:html={svg(i)} /><h3>{h}</h3><p>{p}</p></article>))}
    </div>
  </div>
</section>

<section class="section capabilities" id="safety" aria-labelledby="safety-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Safety</p>
      <h2 class="capability-title" id="safety-title">When something feels off, staff know in seconds</h2>
      <p class="capability-intro">Guests also get local emergency numbers, support lines and a ride home in the app. Chat is checked automatically, an AI host helps, and people make the call. Bans stick, and your team can drill with practice alerts.</p>
    </div>
    <div class="capability-grid steps">
      {safety.map(([i, h, p]) => (<div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>{h}</h3><p>{p}</p></div>))}
    </div>
  </div>
</section>

<section class="section capabilities" id="team" aria-labelledby="team-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Your team</p>
      <h2 class="capability-title" id="team-title">The right access on every device</h2>
    </div>
    <div class="capability-grid venues-grid-4">
      {team.map(([i, h, p]) => (<article class="capability-card"><div class="feature__icon" set:html={svg(i)} /><h3>{h}</h3><p>{p}</p></article>))}
    </div>
  </div>
</section>

<section class="section capabilities" id="promotion" aria-labelledby="promo-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Grow</p>
      <h2 class="capability-title" id="promo-title">Promotion that’s fair, labelled and flat-priced</h2>
      <p class="capability-intro">Venues and events already in Hot Mess can sponsor premium placement for a city’s night. Every sponsored spot says so, it’s priced flat per city and night from a <a href="https://hotmess.social/money">public rate card</a>, never per click or per view, and it follows the city, the night and your tags, never who is looking. You get one honest number back: how many different people saw it each week.</p>
    </div>
  </div>
</section>

<section class="section capabilities" id="yours" aria-labelledby="yours-title">
  <div class="wrap scene">
    <div><p class="eyebrow">Keep it yours</p><h2 id="yours-title">Your guests and<br>your money stay yours.</h2></div>
    <div class="scene-copy">
      <p class="large-copy">We host communities. We don’t collect people.</p>
      <ul class="venues-list">
        <li><strong>Paid straight to you.</strong> Cover is charged on your own Square or Stripe account, with its keys stored encrypted.</li>
        <li><strong>Guests aren’t the product.</strong> Nothing about your guests is sold or used to target ads.</li>
        <li><strong>Privacy guests can feel.</strong> Strangers see each other as “First L.”, and only friends see full names.</li>
        <li><strong>Music you’re licensed to play.</strong> Soundtrack, our background music partner, streams music licensed for businesses, and its now playing and controls are coming to Velvet. Your venue’s settings in the console track which music licences it holds.</li>
        <li><strong>Simple fees.</strong> A venue the Hot Mess team lists is free to list and to run in Velvet. Cover paid in the app carries a 50¢ platform fee, and the guest pays the fees by default. Cover taken at the door has none. We take no commission on your sales.</li>
      </ul>
      <p>Read more about <a href={'/sovereignty/'}>how your data stays yours</a>.</p>
    </div>
  </div>
</section>

<section class="section capabilities" id="start" aria-labelledby="start-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Get started</p>
      <h2 class="capability-title" id="start-title">Open your doors on AudienceKit</h2>
    </div>
    <div class="capability-grid steps venues-grid-4">
      <div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>Get Velvet</h3><p>On iPhone and iPad{velvet?.ios_beta ? ' (beta)' : ''} or Android, from <a href={'/apps/velvet/'}>audiencekit.com/apps/velvet</a>.</p></div>
      <div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>Try the demo venue</h3><p>Run a sample night with no setup and nothing to break.</p></div>
      <div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>Connect your venue</h3><p>Already in Hot Mess? We’ll make you its manager. Signing up on your own in the app is coming soon.</p></div>
      <div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>Put the QR at the door</h3><p>Guests find your chat, your lineup and tonight’s cover in one scan.</p></div>
    </div>
  </div>
</section>

<section class="section wrap closing" aria-labelledby="venues-closing-title"><p class="eyebrow">You bring the crowd.</p><h2 id="venues-closing-title">Let’s fill<br><em>your room.</em></h2><p>Tell us about your venue and your nights.<br>We’ll get you listed and running.</p><a class="button primary" href={`mailto:${site.contact_email}?subject=AudienceKit%20for%20my%20venue`}>Start a conversation <span aria-hidden="true">↗</span></a></section>

</Layout>

<style>
  .venues-hero h1 { font-size: clamp(52px, 7vw, 88px); line-height: .98; }
  .scene-copy p + p { margin-top: 18px; }
  .scene-copy a:not(.button):not(.text-link) { text-decoration: underline; text-underline-offset: 4px; }
  .capability-intro a { text-decoration: underline; text-underline-offset: 4px; }
  .venues-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 28px !important; }
  .venues-grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .venues-tag { margin: 12px 0 0; color: var(--gold, #efc486); }
  .venues-list { margin: 18px 0; padding-left: 1.2em; color: var(--muted); display: grid; gap: 12px; }
  .venues-list strong { color: var(--paper); }
  @media (max-width: 1000px) { .venues-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .venues-grid-4 { grid-template-columns: 1fr; } }
</style>
