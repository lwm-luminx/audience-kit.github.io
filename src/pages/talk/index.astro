---
import Layout from '../../layouts/Default.astro';
import site from '../../data/config.json';

// The "Let's talk" form. It posts form-encoded to the API (POST /v1/public/contact, ContactRequestsController), which
// keeps the message and emails it to us. `about` in the URL (?about=venue) picks the topic. Turnstile shows only once
// `turnstile_site_key` is set in config.json (with TURNSTILE_SECRET_KEY on the API); until then the API's honeypot
// and rate limit hold spam off. If sending fails, the page offers the same message as an email instead.
const interests = [
  ['community', 'Running a community or audience'],
  ['venue', 'A venue'],
  ['talent', 'Performers and talent'],
  ['curator', 'Curating a scene'],
  ['publisher', 'Publishing (Soapbox)'],
  ['developer', 'Building on AudienceKit'],
  ['press', 'Press'],
  ['other', 'Something else'],
];
const siteKey = site.turnstile_site_key;
---
<Layout title="Let’s Talk" description="Tell us about the community, venue or scene you’re building, and we’ll get back to you.">

<section class="section wrap scene sov-hero talk" aria-labelledby="talk-title">
  <div>
    <p class="eyebrow">Let’s talk</p>
    <h1 id="talk-title">Tell us about<br><em>your scene.</em></h1>
    <p class="talk-aside">A real person reads every message, usually within a day or two. Prefer email? Write to <a href={`mailto:${site.contact_email}`}>{site.contact_email}</a>.</p>
  </div>
  <div class="talk-panel">
    <form class="talk-form" data-talk-form action={site.contact_api} method="post" novalidate>
      <div class="talk-row">
        <label>Your name<input name="name" autocomplete="name" required maxlength="120"></label>
        <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200"></label>
      </div>
      <label><span>Organization <span class="talk-optional">(optional)</span></span><input name="organization" autocomplete="organization" maxlength="200" placeholder="Your venue, community or company"></label>
      <label>What’s it about?
        <select name="interest" data-interest>
          <option value="">Choose one</option>
          {interests.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label>Message<textarea name="message" rows="6" required maxlength="5000" placeholder="Who you are, what you’re building, and what you’d like to do with AudienceKit."></textarea></label>
      <label class="talk-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
      <input type="hidden" name="page_url" data-page-url>
      {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark"></div>}
      <p class="talk-error" data-talk-error role="alert" hidden></p>
      <button class="button primary" type="submit" data-talk-submit>Send <span aria-hidden="true">↗</span></button>
    </form>
    <div class="talk-done" data-talk-done hidden tabindex="-1">
      <p class="eyebrow">Sent</p>
      <h2>Thanks, we’ve got it.</h2>
      <p>We’ll reply to the email you gave us. In the meantime, see <a href={'/gallery/'}>what’s been made with AudienceKit</a>.</p>
    </div>
  </div>
</section>

</Layout>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline define:vars={{ contactEmail: site.contact_email }}>
  (function () {
    var form = document.querySelector('[data-talk-form]');
    var error = form.querySelector('[data-talk-error]');
    var submit = form.querySelector('[data-talk-submit]');
    var done = document.querySelector('[data-talk-done]');
    var about = new URLSearchParams(location.search).get('about');
    var select = form.querySelector('[data-interest]');
    if (about && select.querySelector('option[value="' + about.replace(/[^a-z]/g, '') + '"]')) select.value = about;
    form.querySelector('[data-page-url]').value = document.referrer || location.href;

    var labels = { name: 'your name', email: 'a valid email', message: 'a message', form: '' };
    function show(text) { error.textContent = text; error.hidden = false; }
    function emailInstead() {
      var data = new FormData(form);
      var body = data.get('message') + '\n\n' + data.get('name') + (data.get('organization') ? ', ' + data.get('organization') : '');
      var href = 'mailto:' + contactEmail + '?subject=' + encodeURIComponent("Let's talk") + '&body=' + encodeURIComponent(body);
      error.innerHTML = '';
      error.append('We couldn’t send that just now. ');
      var link = document.createElement('a');
      link.href = href; link.textContent = 'Send it as an email instead';
      error.append(link, '.');
      error.hidden = false;
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      error.hidden = true;
      var data = new FormData(form);
      var missing = ['name', 'email', 'message'].filter(function (f) {
        var v = String(data.get(f) || '').trim();
        return !v || (f === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v));
      });
      if (missing.length) { show('Please add ' + missing.map(function (f) { return labels[f]; }).join(' and ') + '.'); return; }
      submit.disabled = true;
      fetch(form.action, { method: 'POST', body: new URLSearchParams(data) })
        .then(function (r) { return r.json().catch(function () { return null; }).then(function (j) { return { status: r.status, body: j }; }); })
        .then(function (res) {
          submit.disabled = false;
          if (res.status === 201) { form.hidden = true; done.hidden = false; done.focus(); return; }
          if (res.status === 422 && res.body && res.body.errors) {
            var errs = res.body.errors;
            if (errs.form) { show(errs.form[0].charAt(0).toUpperCase() + errs.form[0].slice(1) + '.'); return; }
            show('Please check your ' + Object.keys(errs).join(' and ') + '.');
            return;
          }
          if (res.status === 429) { show('That’s a lot of messages from here. Please try again later, or email us.'); return; }
          emailInstead();
        })
        .catch(function () { submit.disabled = false; emailInstead(); });
    });
  })();
</script>

<style>
  .sov-hero h1 { font-size: clamp(52px, 7vw, 88px); line-height: .98; }
  .talk { align-items: start; }
  .talk-aside { margin-top: 28px; color: var(--muted); max-width: 36ch; }
  .talk-aside a, .talk-done a { color: var(--paper); text-decoration: underline; text-underline-offset: 4px; }
  .talk-panel { padding: 32px; border-radius: 24px; border: 1px solid #ffffff1f; background: #ffffff06; }
  .talk-form { display: grid; gap: 18px; }
  .talk-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .talk-form label { display: grid; gap: 8px; font-size: 14px; font-weight: 600; color: var(--paper); }
  .talk-optional { font-weight: 400; color: var(--muted); }
  .talk-form input, .talk-form select, .talk-form textarea { width: 100%; box-sizing: border-box; padding: 12px 14px; border-radius: 12px; border: 1px solid #ffffff2e; background: #0b0812; color: var(--paper); font: inherit; font-size: 16px; font-weight: 400; }
  .talk-form textarea { resize: vertical; min-height: 140px; }
  .talk-form input:focus, .talk-form select:focus, .talk-form textarea:focus { outline: 2px solid var(--gold); outline-offset: 1px; border-color: transparent; }
  .talk-form ::placeholder { color: #8d778d; }
  .talk-honeypot { position: absolute !important; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .talk-error { margin: 0; color: #ffb4c0; font-size: 15px; }
  .talk-error a { color: var(--paper); text-decoration: underline; }
  .talk-form .button { justify-self: start; }
  .talk-form .button:disabled { opacity: .6; cursor: progress; }
  .talk-done h2 { margin-top: 8px; }
  .talk-done p { margin-top: 14px; color: var(--muted); }
  @media (max-width: 760px) { .talk-row { grid-template-columns: 1fr; } .talk-panel { padding: 20px; } }
</style>
