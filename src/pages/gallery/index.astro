---
import Layout from '../../layouts/Default.astro';
import StaffApps from '../../components/StaffApps.astro';
import site from '../../data/config.json';

// Communities running their own app on AudienceKit. Only public apps with real store pages belong here; check the
// links before adding one (checked 2026-11-16: Hack Different is on Google Play, its iPhone app is still in review).
const showcase = [
  {
    slug: 'hotmess',
    name: 'Hot Mess',
    kind: 'Queer nightlife',
    icon: '/assets/brand/hotmess.png',
    tagline: 'Queer nights out, all in one place.',
    blurb: 'Local venues, events, performers and event photos together, with venue chat, safety alerts at the bar, and no targeted ads.',
    site: 'https://hotmess.social',
    siteLabel: 'hotmess.social',
    tone: 'hotmess',
    stores: [
      { label: 'App Store', note: 'Download on the', url: 'https://apps.apple.com/us/app/hot-mess-gay-nightlife/id1195758383' },
      { label: 'Google Play', note: 'Get it on', url: 'https://play.google.com/store/apps/details?id=social.hotmess.android.app' },
    ],
    pending: '',
  },
  {
    slug: 'hack-different',
    name: 'Hack Different',
    kind: 'Hackers & hackerspaces',
    icon: 'https://hackdiffe.rent/assets/hack-different-logo.png',
    tagline: 'Curiosity has no warranty.',
    blurb: 'Hackerspaces, security meetups and hacker conferences: browse spaces near you, see what’s coming up, and follow each space’s chat, mirrored from its Discord.',
    site: 'https://hackdiffe.rent',
    siteLabel: 'hackdiffe.rent',
    tone: 'hack',
    stores: [
      { label: 'Google Play', note: 'Get it on', url: 'https://play.google.com/store/apps/details?id=com.hackdifferent.app' },
    ],
    pending: 'The iPhone app is coming to the App Store.',
  },
];
---
<Layout title="Gallery" description="Apps made with AudienceKit: Hot Mess for queer nightlife, Hack Different for hackerspaces and hacker conferences, and the apps their teams run them with.">

<section class="section wrap scene sov-hero" aria-labelledby="gallery-title">
  <div>
    <p class="eyebrow">Gallery</p>
    <h1 id="gallery-title">Made with<br><em>AudienceKit.</em></h1>
  </div>
  <div class="scene-copy">
    <p class="large-copy">Different scenes, each with an app of its own.</p>
    <p>Every community here has its own name, look, members and rules. Underneath, they share AudienceKit: the venues and events, chat and moderation, safety alerts and the staff apps that keep it all running.</p>
  </div>
</section>

<section class="section wrap gallery" aria-label="Apps made with AudienceKit">
  {showcase.map((app) => (
    <article class={`gallery-card gallery-card--${app.tone}`} data-stats={app.slug}>
      <div class="gallery-art"><img src={app.icon} width="160" height="160" alt={`${app.name} app icon`} loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><span class="gallery-monogram" aria-hidden="true" hidden>{app.name.split(' ').map((w) => w[0]).join('')}</span></div>
      <div class="gallery-copy">
        <p class="eyebrow">{app.kind}</p>
        <h2>{app.name}</h2>
        <p class="large-copy">{app.tagline}</p>
        <p>{app.blurb}</p>
        <p class="gallery-stats" data-stats-line hidden></p>
        <div class="store-buttons">
          {app.stores.map((store) => (
            <a class="store-button" href={store.url} data-platform={store.label === 'App Store' ? 'ios' : 'android'}>
              {store.label === 'App Store'
                ? <svg viewBox="14.5 8.5 15 22" aria-hidden="true"><path fill="currentColor" d="M24.77 20.3a4.95 4.95 0 0 1 2.36-4.15 5.07 5.07 0 0 0-4-2.16c-1.68-.18-3.3 1-4.16 1-.87 0-2.19-.99-3.6-.96a5.32 5.32 0 0 0-4.48 2.73c-1.93 3.35-.49 8.27 1.36 10.98.93 1.32 2.01 2.8 3.43 2.75 1.39-.06 1.9-.88 3.58-.88 1.66 0 2.14.88 3.59.85 1.49-.02 2.43-1.33 3.32-2.67a10.96 10.96 0 0 0 1.52-3.1 4.78 4.78 0 0 1-2.92-4.39Z"/><path fill="currentColor" d="M22.04 12.21a4.87 4.87 0 0 0 1.11-3.49 4.96 4.96 0 0 0-3.2 1.66 4.64 4.64 0 0 0-1.15 3.36 4.1 4.1 0 0 0 3.24-1.53Z"/></svg>
                : <svg viewBox="0 0 24 26" aria-hidden="true"><path fill="currentColor" d="M2.2.6C1.6.9 1.2 1.6 1.2 2.5v21c0 .9.4 1.6 1 1.9L14 13 2.2.6zm13.2 11L4.3.3l12.6 7.2-1.5 4.1zm0 2.8 1.5 4.1L4.3 25.7l11.1-11.3zm2.7-6.1 3.6 2.1c1.3.8 1.3 2.5 0 3.2l-3.6 2.1-1.7-3.7 1.7-3.7z"/></svg>}
              <span><small>{store.note}</small>{store.label}</span>
            </a>
          ))}
          {app.pending && <p class="store-note">{app.pending}</p>}
        </div>
        <p><a class="text-link" href={app.site}>{app.siteLabel} <span aria-hidden="true">↗</span></a></p>
      </div>
    </article>
  ))}
</section>

<section class="kit-section" id="behind" aria-labelledby="behind-title"><div class="wrap">
  <div class="section-heading"><div><p class="eyebrow">Behind every app</p><h2 id="behind-title">The apps their<br>teams run them with.</h2></div><p>The same staff apps work for every community.<br><a class="text-link" href={'/apps/'}>All the apps <span aria-hidden="true">→</span></a></p></div>
  <StaffApps />
</div></section>

<section class="section wrap closing" aria-labelledby="gallery-closing-title"><p class="eyebrow">Your scene next.</p><h2 id="gallery-closing-title">Put your community<br><em>in the gallery.</em></h2><p>Tell us about the scene you’re building.<br>We’ll set it up as its own app.</p><a class="button primary" href={`mailto:${site.contact_email}?subject=Make%20a%20Scene`}>Start a conversation <span aria-hidden="true">↗</span></a></section>

</Layout>

<script is:inline>
  // Each app's live headline numbers (GET /v1/public/audiences/<subdomain>/stats). The line stays hidden unless they load.
  document.querySelectorAll('[data-stats]').forEach(function (card) {
    var line = card.querySelector('[data-stats-line]');
    fetch('https://api.audiencekit.com/v1/public/audiences/' + card.getAttribute('data-stats') + '/stats')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (s) {
        if (!s || !s.venues) return;
        var n = function (x) { return Number(x).toLocaleString('en-US'); };
        var parts = [n(s.venues) + ' venues', n(s.places) + (s.places === 1 ? ' city' : ' cities')];
        if (s.countries && s.countries.length > 1) parts.push(s.countries.length + ' countries');
        line.textContent = 'Live now: ' + parts.join(' · ');
        line.hidden = false;
      })
      .catch(function () {});
  });
</script>

<style>
  .sov-hero h1 { font-size: clamp(52px, 7vw, 88px); line-height: .98; }
  .scene-copy p + p { margin-top: 18px; }
  .gallery { display: grid; gap: 36px; }
  .gallery-card { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: center; padding: 40px; border-radius: 24px; border: 1px solid #ffffff1f; }
  .gallery-card--hotmess { background: radial-gradient(ellipse at 85% 10%, #e6557030, transparent 55%), radial-gradient(ellipse at 0% 100%, #554df040, transparent 70%), #2a1029; }
  .gallery-card--hack { background: radial-gradient(ellipse at 85% 10%, #c5f46722, transparent 55%), radial-gradient(ellipse at 0% 100%, #009ac830, transparent 70%), #111a12; }
  .gallery-art { display: grid; place-items: center; min-height: 280px; }
  .gallery-art img { width: 180px; height: 180px; border-radius: 22%; box-shadow: 0 18px 48px #0006; object-fit: cover; background: #0b0812; }
  .gallery-monogram { display: grid; place-items: center; width: 180px; height: 180px; border-radius: 22%; background: #c5f467; color: #171d10; font-size: 64px; font-weight: 700; letter-spacing: -.04em; box-shadow: 0 18px 48px #0006; }
  .gallery-monogram[hidden], .gallery-art img[hidden] { display: none; }
  .gallery-copy h2 { margin-top: 8px; font-size: clamp(36px, 4.5vw, 56px); }
  .gallery-copy > p { margin-top: 14px; max-width: 58ch; }
  .gallery-copy p:not(.large-copy):not(.eyebrow) { color: var(--muted); }
  .gallery-stats { font-weight: 600; color: var(--paper) !important; }
  @media (max-width: 760px) {
    .gallery-card { grid-template-columns: 1fr; gap: 20px; padding: 24px; }
    .gallery-art { min-height: 0; justify-items: start; }
    .gallery-art img, .gallery-monogram { width: 112px; height: 112px; font-size: 40px; }
  }
</style>
