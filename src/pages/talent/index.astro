---
import Layout from '../../layouts/Default.astro';
import site from '../../data/config.json';
import apps from '../../data/staff_apps.json';
import StoreButtons from '../../components/StoreButtons.astro';
const backstage = apps.find((app) => app.slug === 'backstage')!;
const hotMess = {
  ios: 'https://apps.apple.com/us/app/hot-mess-gay-nightlife/id1195758383',
  android: 'https://play.google.com/store/apps/details?id=social.hotmess.android.app',
};
const mail = (subject: string) => `mailto:${site.contact_email}?subject=${encodeURIComponent(subject)}`;
const icon = {
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  heart: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  repeat: '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14M7 22l-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>',
  plus: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M12 13v6M9 16h6"/>',
  chat: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  flag: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22v-7"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>',
};
const svg = (name: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name as keyof typeof icon]}</svg>`;
const found = [
  ['user', 'Your own page', 'Your name, photo, Instagram and TikTok on a performer page in Hot Mess, linked from every night you play.'],
  ['pin', 'On the lineup, where people look', 'Your appearances show on the venue’s page, the event and the city’s Tonight view. KJs, DJs and VJs show by role, and when you’re the only one on a night, you’re its host.'],
  ['image', 'Posters with your approved photo', 'When you headline, the venue can make story, feed and print posters from the photo you approved.'],
];
const app = [
  ['heart', 'Tips go straight to you', 'Keep your Cash App and Venmo links current. Fans tip you in those apps. AudienceKit takes no part in the payment and charges no commission on it.'],
  ['calendar', 'See where you’re on', 'Every upcoming appearance on your listing, with the venue, the time and the event details.'],
  ['bell', 'A nudge before you’re on', 'Turn on reminders for a night and your phone alerts you a day, three hours and fifteen minutes before.'],
  ['repeat', 'Set up your residencies', 'A weekly show or a first-Friday night, with time, length, description and ticket link. One-off changes and skipped dates are kept.'],
  ['plus', 'Add a one-off night', 'List a show of your own, at a venue you manage, your home venue, or in a city with the venue still to come.'],
  ['chat', 'Talk to your crowd', 'Post in the rooms of the venues you play and the cities you’re featured in, as your listing with a Host tag: a message, a photo or one of your events.'],
];
const together = [
  ['users', 'Troupes and collectives', 'Manage yourself and your troupe from one account. Each listing keeps its own profile and nights, and members can act for the troupe.'],
  ['mic', 'One listing, many hands', 'A listing can have more than one manager, and switching listings never changes who you are signed in as.'],
  ['flag', 'Report and block', 'Long-press anyone’s message to report it or block them. Reports go to the people who run that city, who act on them.'],
];
---
<Layout title="AudienceKit for Talent" description="Backstage is the AudienceKit app for performers, hosts, KJs, DJs, VJs and collectives: keep your page and tip links current, set up your residencies, get reminded before you’re on, and talk to your crowd." image="/assets/brand/backstage.png">

<section class="section wrap scene talent-hero" aria-labelledby="talent-title">
  <div class="talent-art"><img src="/assets/brand/backstage.png" width="768" height="768" alt={backstage.alt} fetchpriority="high"></div>
  <div class="scene-copy">
    <p class="eyebrow">Backstage · AudienceKit for talent</p>
    <h1 id="talent-title">You make<br><em>the scene.</em></h1>
    <p class="large-copy">For performers, hosts, KJs, DJs, VJs and collectives.</p>
    <p>Drag artists, DJs, hosts and the troupes behind every night out are why people go. Backstage keeps your page, your nights and your tip links current across <a href="https://hotmess.social">Hot Mess</a> and the other apps built on AudienceKit, so the people who love your work can find you, show up and tip you.</p>
    <p>Your page is yours, your fans are yours, and your tips are all yours.</p>
    <p class="talent-cta"><a class="button primary" href={'/apps/backstage/'}>Get Backstage</a><a class="text-link" href="#start">How to get on <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<section class="section capabilities" id="found" aria-labelledby="found-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Where fans find you</p>
      <h2 class="capability-title" id="found-title">On every night you play</h2>
      <p class="capability-intro">Hot Mess is the app for queer nights out, on iPhone, Android and the web. Your page sits beside the venues and events you play, so people who are deciding where to go tonight see you.</p>
    </div>
    <div class="capability-grid steps">
      {found.map(([i, h, p]) => (<article class="capability-card"><div class="feature__icon" set:html={svg(i)} /><h3>{h}</h3><p>{p}</p></article>))}
    </div>
  </div>
</section>

<section class="section capabilities" id="app" aria-labelledby="app-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">The Backstage app · iPhone, iPad and Android</p>
      <h2 class="capability-title" id="app-title">Your career, in your pocket</h2>
      <p class="capability-intro">Backstage is on the App Store and Google Play. Sign in with the Facebook account that manages your Page, or with Apple, pick the listing you manage, and you’re in.</p>
      <div class="talent-store"><StoreButtons app={backstage} /><a class="text-link" href={'/apps/backstage/'}>audiencekit.com/apps/backstage</a></div>
    </div>
    <div class="capability-grid steps">
      {app.map(([i, h, p]) => (<article class="capability-card"><div class="feature__icon" set:html={svg(i)} /><h3>{h}</h3><p>{p}</p></article>))}
    </div>
  </div>
</section>

<section class="section capabilities" id="together" aria-labelledby="together-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Built for how talent works</p>
      <h2 class="capability-title" id="together-title">Solo, or with your crew</h2>
    </div>
    <div class="capability-grid steps">
      {together.map(([i, h, p]) => (<article class="capability-card"><div class="feature__icon" set:html={svg(i)} /><h3>{h}</h3><p>{p}</p></article>))}
    </div>
  </div>
</section>

<section class="section capabilities" id="status" aria-labelledby="status-title">
  <div class="wrap scene">
    <div><p class="eyebrow">Where it stands</p><h2 id="status-title">What’s ready<br>today.</h2></div>
    <div class="scene-copy">
      <ul class="talent-list">
        <li><strong>On the App Store and Google Play.</strong> Backstage for iPhone, iPad and Android: your profile and tip links, appearances, reminders, residencies, one-off nights and chat.</li>
        <li><strong>iPhone and iPad.</strong> Invites by QR code. Scan one from a venue or the people who run your city to take over your page or set up a new one, no download needed first.</li>
        <li><strong>Not in Backstage.</strong> Payments. Tips happen in Cash App or Venmo, between you and your fans.</li>
      </ul>
      <p>Want to see it step by step? Read <a href={backstage.record_url}>a performer’s gig in Backstage (PDF)</a>. Read how AudienceKit handles <a href={'/safety/'}>safety in chat</a> and keeps <a href={'/sovereignty/'}>your fans’ data out of the ad business</a>.</p>
    </div>
  </div>
</section>

<section class="section capabilities" id="start" aria-labelledby="start-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Get started</p>
      <h2 class="capability-title" id="start-title">Get on the lineup</h2>
      <p class="capability-intro">Your page is set up by the people who run your city’s audience, or by a venue you play. There’s no public sign-up, so nobody else can claim your name.</p>
    </div>
    <div class="capability-grid steps">
      <div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>Ask who books you</h3><p>Ask the venue or promoter for an invite to Backstage, or <a href={mail('Backstage for my act')}>email us</a> your name, your city and your socials.</p></div>
      <div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>Take over your page</h3><p>Scan the invite or sign in, and your page is yours to manage. Add a co-manager whenever you like.</p></div>
      <div class="capability-card step"><div class="step__num" aria-hidden="true"></div><h3>Fill your calendar</h3><p>Add your residencies and one-off nights, turn on reminders, and say hi in the rooms you play.</p></div>
    </div>
    <p class="talent-readers">See your page the way fans do: get Hot Mess on the <a href={hotMess.ios}>App Store</a> or <a href={hotMess.android}>Google Play</a>, or visit <a href="https://hotmess.social">hotmess.social</a>.</p>
  </div>
</section>

<section class="section wrap closing" aria-labelledby="talent-closing-title"><p class="eyebrow">You bring the crowd.</p><h2 id="talent-closing-title">Let the crowd<br><em>find you.</em></h2><p>Tell us who you are and where you play.<br>We’ll get your page in front of your fans.</p><a class="button primary" href={mail('Backstage for my act')}>Start a conversation <span aria-hidden="true">↗</span></a></section>

</Layout>

<style>
  .talent-hero { align-items: center; }
  .talent-hero h1 { font-size: clamp(48px, 6.5vw, 84px); line-height: .98; margin-top: 8px; }
  .talent-art img { width: 100%; max-width: 440px; height: auto; border-radius: 28px; display: block; }
  .scene-copy p + p { margin-top: 18px; }
  .scene-copy a:not(.button):not(.text-link), .capability-intro a, .talent-readers a, .capability-card a { text-decoration: underline; text-underline-offset: 4px; }
  .talent-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 28px !important; }
  .talent-list { margin: 18px 0; padding-left: 1.2em; color: var(--muted); display: grid; gap: 12px; }
  .talent-list strong { color: var(--paper); }
  .talent-store { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 24px; }
  .talent-readers { margin-top: 28px; color: var(--muted); }
  @media (max-width: 640px) { .talent-art img { max-width: 280px; } }
</style>
