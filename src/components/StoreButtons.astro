---
const { app } = Astro.props;
---


<div class="store-buttons">
  <a class="store-button" href={app.ios_url} data-platform="ios">
    <svg viewBox="14.5 8.5 15 22" aria-hidden="true"><path fill="currentColor" d="M24.77 20.3a4.95 4.95 0 0 1 2.36-4.15 5.07 5.07 0 0 0-4-2.16c-1.68-.18-3.3 1-4.16 1-.87 0-2.19-.99-3.6-.96a5.32 5.32 0 0 0-4.48 2.73c-1.93 3.35-.49 8.27 1.36 10.98.93 1.32 2.01 2.8 3.43 2.75 1.39-.06 1.9-.88 3.58-.88 1.66 0 2.14.88 3.59.85 1.49-.02 2.43-1.33 3.32-2.67a10.96 10.96 0 0 0 1.52-3.1 4.78 4.78 0 0 1-2.92-4.39Z"/><path fill="currentColor" d="M22.04 12.21a4.87 4.87 0 0 0 1.11-3.49 4.96 4.96 0 0 0-3.2 1.66 4.64 4.64 0 0 0-1.15 3.36 4.1 4.1 0 0 0 3.24-1.53Z"/></svg>
    <span><small>{app.ios_beta ? "iPhone & iPad beta on" : "Download on the"}</small>{app.ios_beta ? "TestFlight" : "App Store"}</span>
  </a>
  <a class="store-button" href={app.android_url} data-platform="android">
    <svg viewBox="0 0 24 26" aria-hidden="true"><path fill="currentColor" d="M2.2.6C1.6.9 1.2 1.6 1.2 2.5v21c0 .9.4 1.6 1 1.9L14 13 2.2.6zm13.2 11L4.3.3l12.6 7.2-1.5 4.1zm0 2.8 1.5 4.1L4.3 25.7l11.1-11.3zm2.7-6.1 3.6 2.1c1.3.8 1.3 2.5 0 3.2l-3.6 2.1-1.7-3.7 1.7-3.7z"/></svg>
    <span><small>{app.android_beta ? "Android beta on" : "Get it on"}</small>Google Play</span>
  </a>
</div>
