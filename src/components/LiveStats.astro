---
// Hot Mess's live headline numbers (GET /v1/public/audiences/hotmess/stats), shown as a split-flap departures
// board: the numbers flip into place when the board scrolls into view and flip again when they change. Screen readers
// get the plain sentence (the flaps are aria-hidden), and with reduced motion the numbers just appear.
// The board's Events and People columns (newer fields in the stats) show only once the API sends them.
// The section stays hidden unless the numbers load, so the page never shows a stale or empty count.
interface Props {
  eyebrow: string;
  intro: string;
}
const { eyebrow, intro } = Astro.props;
---
<section class="section capabilities live-stats" id="live" aria-labelledby="live-title" hidden data-stats-url="https://api.audiencekit.com/v1/public/audiences/hotmess/stats">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow live-stats__eyebrow"><span class="live-dot" aria-hidden="true"></span>{eyebrow}</p>
      <h2 class="capability-title" id="live-title">
        <span class="sr-only" data-live-text="headline"></span>
        <span class="live-stats__headline" aria-hidden="true"><span class="flaps" data-flaps="venues"></span> venues in <span class="flaps" data-flaps="places"></span> places</span>
      </h2>
      <p class="capability-intro">{intro} <span data-live-text="as_of"></span></p>
    </div>
    <div class="board" data-board>
      <ul class="sr-only" data-live-text="countries"></ul>
      <div class="board__frame" aria-hidden="true">
        <div class="board__row board__row--head"><span>Where</span><span>Places</span><span>Venues</span></div>
        <div data-board-rows></div>
      </div>
    </div>
  </div>
</section>

<script is:inline src="/assets/js/live-stats.js" defer></script>
