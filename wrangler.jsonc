{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audience-kit-github-io",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "build": {
    "command": "npm run build"
  }
}
